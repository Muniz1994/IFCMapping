# Copy this file to .env and fill in your key. .env is not committed (see .gitignore).
# Variables already set in the terminal take precedence over .env.

# Anthropic API key (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=

# Workspace ID (wrkspc_...). Only needed when the API key is not scoped to a workspace;
# find it in the Claude Console under Settings > Workspaces.
ANTHROPIC_WORKSPACE_ID=

# Model: claude-opus-5-5 (default), claude-sonnet-5-5 (cheaper), claude-haiku-5-5 (cheapest)
IFCMAPPING_MODEL=claude-opus-5-5

# Reasoning effort: low, medium (default), high
IFCMAPPING_EFFORT=medium
